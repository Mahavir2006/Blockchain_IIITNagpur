{
  "name": "black-hole-ledger",
  "version": "1.0.0",
  "description": "Verifiable NGO donation-accountability protocol — CASCADE '26 Theme 4 Problem 2",
  "private": true,
  "scripts": {
    "setup": "npm install",
    "chain:up": "echo 'Start two local Hardhat nodes: npx hardhat node (chain 31337) and npx hardhat node --port 8546 --hostname 127.0.0.1 (chain 31338)'",
    "deploy:local": "npx hardhat run scripts/deploy-local.ts --network localhost",
    "services:up": "npm run api",
    "dev": "npm --prefix dashboard run dev",
    "demo:redteam": "npx hardhat run scripts/redteam.ts",
    "demo:redteam:localhost": "npx hardhat run scripts/redteam.ts --network localhost",
    "test": "npx hardhat test",
    "coverage": "npx hardhat coverage",
    "lint": "npx eslint . --ext .ts,.sol && npx solhint 'contracts/**/*.sol'",
    "format": "npx prettier --write .",
    "api": "npx hardhat run services/api/server.ts --network localhost"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@openzeppelin/hardhat-upgrades": "^3.0.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "chai": "^4.4.0",
    "ethers": "^6.13.0",
    "hardhat": "^2.29.1",
    "hardhat-gas-reporter": "^1.0.10",
    "mocha": "^10.0.0",
    "prettier": "^3.0.0",
    "solhint": "^3.6.0",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0"
  }
}
