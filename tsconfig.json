{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "./typechain",
    "rootDir": "./"
  },
  "include": ["scripts/**/*.ts", "test/**/*.ts", "services/**/*.ts"],
  "exclude": ["node_modules", "typechain", "coverage", "dashboard"]
}
